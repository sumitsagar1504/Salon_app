rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function primaryOwner() { return signedIn() && request.auth.uid == 'NIgb3JbjMBXGzaQaGKNfgGwNxyv1'; }
    function admin() {
      return signedIn() &&
        (primaryOwner() || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function slotPath(id) { return /databases/$(database)/documents/bookingSlots/$(id); }
    function appointmentPath(id) { return /databases/$(database)/documents/appointments/$(id); }
    function slotId(data) { return data.serviceId + '|' + data.date + '|' + data.timeSlot; }
    match /users/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role']) &&
        ((own(uid) && request.resource.data.role == 'customer') ||
         (admin() && request.resource.data.role == 'admin' &&
          existsAfter(/databases/$(database)/documents/admins/$(uid))));
      allow update: if
        (own(uid) && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name'])) ||
        (admin() && resource.data.role == 'customer' &&
          request.resource.data.role == 'admin' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          existsAfter(/databases/$(database)/documents/admins/$(uid)));
      allow delete: if false;
    }
    match /admins/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if admin() &&
        request.resource.data.uid == uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'createdAt', 'createdBy']) &&
        getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'admin' &&
        getAfter(/databases/$(database)/documents/users/$(uid)).data.email ==
          request.resource.data.email;
      allow update, delete: if false;
    }
    match /adminRequests/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if own(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'status', 'createdAt']);
      allow delete: if admin();
      allow update: if false;
    }
    match /services/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /appointments/{id} {
      allow get, list: if admin() ||
        (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.customerEmail == request.auth.token.email &&
        request.resource.data.timeSlot in ['09:00 AM', '10:00 AM', '11:00 AM', '12:00 PM', '02:00 PM', '03:00 PM', '04:00 PM', '05:00 PM', '06:00 PM'] &&
        request.resource.data.keys().hasOnly([
          'customerId', 'customerName', 'customerEmail', 'serviceId',
          'serviceName', 'servicePrice', 'date', 'timeSlot', 'status', 'createdAt',
          'priorityRequested', 'priorityNote', 'priorityFee', 'priorityStatus']) &&
        (!request.resource.data.keys().hasAny(['priorityRequested']) ||
          (request.resource.data.keys().hasAll([
            'priorityRequested', 'priorityNote', 'priorityFee', 'priorityStatus']) &&
           request.resource.data.priorityRequested is bool &&
           request.resource.data.priorityNote is string &&
           request.resource.data.priorityNote.size() <= 500 &&
           request.resource.data.priorityFee == 0 &&
           ((request.resource.data.priorityRequested == true &&
             request.resource.data.priorityNote.size() >= 10 &&
             request.resource.data.priorityStatus == 'requested') ||
            (request.resource.data.priorityRequested == false &&
             request.resource.data.priorityNote == '' &&
             request.resource.data.priorityStatus == 'none')))) &&
        get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.name == request.resource.data.serviceName &&
        get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.price == request.resource.data.servicePrice &&
        existsAfter(slotPath(slotId(request.resource.data))) &&
        getAfter(slotPath(slotId(request.resource.data))).data.appointmentId == id;
      allow update: if resource.data.status == 'pending' && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          ((admin() &&
            ((request.resource.data.status == 'cancelled' &&
              !existsAfter(slotPath(slotId(resource.data)))) ||
             (request.resource.data.status == 'confirmed' &&
              (resource.data.get('priorityRequested', false) == false ||
               resource.data.get('priorityStatus', 'none') in ['accepted', 'declined'])))) ||
           (own(resource.data.customerId) &&
             request.resource.data.status == 'cancelled' &&
             !existsAfter(slotPath(slotId(resource.data)))))) ||
        (admin() && resource.data.get('priorityRequested', false) == true &&
          resource.data.priorityStatus == 'requested' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['priorityFee', 'priorityStatus']) &&
          request.resource.data.priorityStatus == 'quoted' &&
          request.resource.data.priorityFee is number &&
          request.resource.data.priorityFee > 0 &&
          request.resource.data.priorityFee <= 100000) ||
        (own(resource.data.customerId) &&
          resource.data.get('priorityRequested', false) == true &&
          resource.data.priorityStatus == 'quoted' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['priorityFee', 'priorityStatus']) &&
          ((request.resource.data.priorityStatus == 'accepted' &&
            request.resource.data.priorityFee == resource.data.priorityFee) ||
           (request.resource.data.priorityStatus == 'declined' &&
            request.resource.data.priorityFee == 0)))
      );
      allow delete: if false;
    }
    match /bookingSlots/{id} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['appointmentId', 'serviceId', 'date', 'timeSlot']) &&
        id == slotId(request.resource.data) &&
        getAfter(appointmentPath(request.resource.data.appointmentId)).data.customerId == request.auth.uid &&
        getAfter(appointmentPath(request.resource.data.appointmentId)).data.status == 'pending' &&
        getAfter(appointmentPath(request.resource.data.appointmentId)).data.serviceId == request.resource.data.serviceId &&
        getAfter(appointmentPath(request.resource.data.appointmentId)).data.date == request.resource.data.date &&
        getAfter(appointmentPath(request.resource.data.appointmentId)).data.timeSlot == request.resource.data.timeSlot;
      allow delete: if signedIn() &&
        (admin() || own(get(appointmentPath(resource.data.appointmentId)).data.customerId)) &&
        getAfter(appointmentPath(resource.data.appointmentId)).data.status == 'cancelled';
      allow update: if false;
    }
  }
}
